@startuml
skinparam packageStyle rectangle

package "transcript (public)" {
  class Transcript
  class Segment
  class "Client" as PublicClient
  interface Provider
  class FallbackProvider
  class SpeechToTextProvider
  interface AudioSource
  class YTDLPAudioSource
  interface Transcriber
  class Audio
  class Options
  class WebVTTParser
}

package "internal/ytdlp" {
  class "Client" as YTDLPClient
  interface CommandRunner
  class Metadata
  class CaptionTrack
  class AudioArtifact
}

package "planned Milestone 5 adapters" #EEEEEE {
  interface AudioProcessor <<decision pending>>
  class FFmpegProcessor <<conditional, planned>>
  class WhisperCPPTranscriber <<prototype planned>>
  class HostedTranscriber <<prototype planned>>
}

package "cmd/ytextract" {
  class CLI
}

CLI --> PublicClient : calls public API
PublicClient --> Provider : orchestrates
FallbackProvider --> Provider : primary then explicit fallback
FallbackProvider --> SpeechToTextProvider : optional fallback
SpeechToTextProvider --> AudioSource : acquires checked audio
SpeechToTextProvider --> Transcriber : produces segments
AudioSource --> Audio
YTDLPAudioSource ..|> AudioSource
YTDLPAudioSource --> YTDLPClient : checked audio download
YTDLPClient --> AudioArtifact : returns owned artifact
AudioProcessor <|.. FFmpegProcessor
WhisperCPPTranscriber ..|> Transcriber
HostedTranscriber ..|> Transcriber
YTDLPClient --> CommandRunner
YTDLPClient --> Metadata : inspects
Metadata *-- CaptionTrack
Transcript *-- Segment
WebVTTParser --> Segment : normalizes
@enduml
