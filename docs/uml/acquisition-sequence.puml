@startuml
actor Caller
participant "transcript API" as API
participant "yt-dlp provider" as Provider
participant "FallbackProvider" as Fallback
participant "SpeechToTextProvider" as Speech
participant "yt-dlp process" as YTDLP
participant "WebVTT parser" as Parser
participant "yt-dlp audio source" as AudioSource
participant "configured transcriber\n(adapter planned)" as Transcriber

Caller -> API: Get(ctx, input, options)
API -> API: parse video ID
alt explicit fallback configured
  API -> Fallback: Get(ctx, videoID, options)
  Fallback -> Provider: Get(ctx, videoID, options)
else caption provider only
  API -> Provider: Get(ctx, videoID, options)
end
Provider -> YTDLP: inspect machine-readable metadata
YTDLP --> Provider: available caption tracks
Provider -> Provider: select by language and source policy
alt matching captions available
  Provider -> YTDLP: retrieve selected WebVTT track
  YTDLP --> Provider: subtitle data
  Provider -> Parser: parse and normalize
  Parser --> Provider: ordered segments
  alt explicit fallback configured
    Provider --> Fallback: Transcript
    Fallback --> API: Transcript
  else caption provider only
    Provider --> API: Transcript
  end
  API --> Caller: Transcript
else captions unavailable and explicit fallback configured
  Provider --> Fallback: ErrTranscriptUnavailable
  Fallback -> Speech: Get(ctx, videoID, options)
  Speech -> AudioSource: Acquire(ctx, videoID, limits)
  AudioSource -> YTDLP: inspect duration
  YTDLP --> AudioSource: duration and audio metadata
  AudioSource -> AudioSource: reject over-limit input
  AudioSource -> YTDLP: download audio to isolated storage
  YTDLP --> AudioSource: downloaded audio artifact
  AudioSource --> Speech: checked Audio
  Speech -> Speech: verify duration and size
  Speech -> Transcriber: Transcribe(ctx, audio, language hints)
  Transcriber --> Speech: language, provider, segments
  Speech -> Speech: validate Transcript
  Speech -> AudioSource: close audio and remove artifacts
  Speech --> Fallback: speech-to-text Transcript
  Fallback --> API: speech-to-text Transcript
  API -> API: validate Transcript
  API --> Caller: speech-to-text Transcript
else captions unavailable and no fallback configured
  Provider --> API: ErrTranscriptUnavailable
  API --> Caller: ErrTranscriptUnavailable
end
@enduml
