# Copy this file to .env and replace the example paths. The local .env file is
# ignored by Git. These are Make assignments: do not quote paths containing
# spaces, and prefer forward slashes in Windows paths.

# Optional when whisper-cli is already available on PATH.
WHISPER_CLI = C:/path/to/whisper-cli.exe
# Optional on Windows; use the runtime directory matching the whisper.cpp build.
WHISPER_RUNTIME_DIR = C:/msys64/ucrt64/bin
WHISPER_MODEL = C:/path/to/ggml-base.bin
WHISPER_SAMPLE = C:/path/to/sample.wav
